# Google API credentials file path
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json

# Google Sheet ID (from the URL of your Google Sheet)
GOOGLE_SHEET_ID=your_sheet_id_here

# Anthropic API key for intelligent email parsing (optional but recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail search query to filter emails (optional, defaults to all emails)
# Example: GMAIL_QUERY=from:(amazon.com OR ebay.com OR etsy.com)
GMAIL_QUERY=

# How many days back to search for emails on first run (optional, default: 30)
LOOKBACK_DAYS=30

# Enable debug logging (optional, default: false)
DEBUG=false
